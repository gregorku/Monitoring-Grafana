///////////////////////////////////////////////////////////////////////////////
//
// Monitoring-Grafana Project
//
// File:
//   configs/alloy/config.alloy
//
// Description:
//   Grafana Alloy configuration for Docker container log collection.
//
///////////////////////////////////////////////////////////////////////////////

// Discover Docker containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Collect Docker container logs
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.default.receiver]
  
  // Add container metadata as labels
  labels = {
    container       = "__meta_docker_container_name",
    image          = "__meta_docker_container_image", 
    compose_service = "__meta_docker_container_label_com_docker_compose_service",
  }
}

// Write logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
